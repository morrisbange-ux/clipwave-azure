# Copy to .env (or set in your shell). Leave Azure values empty to run fully locally.
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
# Azure Blob Storage (videos). Empty = store on local disk in ./uploads
AZURE_STORAGE_CONNECTION_STRING=
STORAGE_CONTAINER=videos
# Azure Cosmos DB (metadata). Empty = in-memory database
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=clipwave
COSMOS_CONTAINER_PREFIX=
# Azure Application Insights (telemetry). Empty = disabled
APPLICATIONINSIGHTS_CONNECTION_STRING=
